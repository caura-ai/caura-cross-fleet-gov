# Environment
.env

# OpenClaw plugin — fetched at install time, not vendored
.openclaw/plugins/**/node_modules/
.openclaw/plugins/**/dist/
.openclaw/plugins/**/src/
.openclaw/plugins/**/skills/
.openclaw/plugins/**/tools.json
.openclaw/plugins/**/package.json
.openclaw/plugins/**/tsconfig.json
.openclaw/plugins/**/.env

# OpenClaw plugin runtime state
.openclaw/plugins/installs.json
.openclaw/plugins/memclaw/install.json
.openclaw/plugins/memclaw/.allowlist-applied
.openclaw/plugins/memclaw/.educated

# OpenClaw runtime — never commit these
.openclaw/agents/
.openclaw/canvas/
.openclaw/flows/
.openclaw/identity/
.openclaw/logs/
.openclaw/memory/
.openclaw/tasks/
.openclaw/plugin-skills/
.openclaw/openclaw.json.bak
.openclaw/openclaw.json.last-good
.openclaw/gateway.cmd
.openclaw/update-check.json
.openclaw/workspace-state.json

# OpenClaw workspace runtime state
agents/**/.openclaw/
workspace-*/
workspace/

# Claude Code local settings
.claude/settings.local.json

# Node
node_modules/

# SQLite databases
*.sqlite
*.sqlite-shm
*.sqlite-wal

# Python
__pycache__/
*.pyc
*.pyo
*.egg-info/
dist/
build/
.venv/
venv/
.pytest_cache/

# OS
.DS_Store
Thumbs.db

# Bare git clones / mirrors
*.git/

# detect-secrets baseline — machine-specific, not committed
.secrets.baseline
